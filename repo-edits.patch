   copy .\public\admin-dashboard.html .\backups\admin-dashboard.html.bak
   copy .\public\student-dashboard.html .\backups\student-dashboard.html.bak
   copy .\public\teacher-dashboard.html .\backups\teacher-dashboard.html.bak

2) Overwrite with updated files provided here:
   copy .\admin-dashboard.html.new .\public\admin-dashboard.html /Y
   copy .\student-dashboard.html.new .\public\student-dashboard.html /Y
   copy .\teacher-dashboard.html.new .\public\teacher-dashboard.html /Y

3) (Optional) Create a git commit and patch locally:
   git init   # if repo not already initialized
   git add public\admin-dashboard.html public\student-dashboard.html public\teacher-dashboard.html
   git commit -m "fix: centralize Authorization headers and fix malformed fetch() calls in dashboards\n\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>"
