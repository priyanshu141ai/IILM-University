# ==========================================
# College MOU Portal - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values
# Run: cp .env.example .env  (Mac/Linux)
# Run: copy .env.example .env  (Windows)
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# ------------------------------------------
# Option 1: Local MongoDB (default)
MONGODB_URI=mongodb://localhost:27017/college-mou-portal

# Option 2: MongoDB Atlas (Cloud - Recommended for production)
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/college-mou-portal?retryWrites=true&w=majority
# ------------------------------------------

# College email domain (used to restrict signups to institutional emails)
# Example: COLLEGE_EMAIL_DOMAIN=iilm.edu
COLLEGE_EMAIL_DOMAIN=iilm.edu

# JWT Secret Key
# ------------------------------------------
# IMPORTANT: Change this to a long, random string in production!
# Generate one using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_use_a_long_random_string
# ------------------------------------------

